# ============ SERVER CONFIGURATION ============
NODE_ENV=production
PORT=5000

# ============ DATABASE ============
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/rshop_db

# ============ JWT AUTHENTICATION ============
# Secret key for JWT token signing (change this in production!)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production_min_32_chars

# ============ SESSION ============
# Secret for session management (change this in production!)
SESSION_SECRET=your_session_secret_here_change_in_production

# ============ GOOGLE OAUTH 2.0 ============
# Obtain from: https://console.developers.google.com/
# 1. Create a new OAuth 2.0 application
# 2. Add authorized redirect URIs
# 3. Create an OAuth 2.0 ID (Web application)
# 4. Copy Client ID and Client Secret

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# For production (Render, Railway, etc):
# GOOGLE_CALLBACK_URL=https://your-app-name.onrender.com/api/auth/google/callback

# ============ TWO-FACTOR AUTHENTICATION (2FA) ============
# Enable 2FA for additional security
ENABLE_2FA=false

# ============ EMAIL CONFIGURATION (Optional - for 2FA codes) ============
# If ENABLE_2FA=true, you need email configuration to send verification codes
# Using Gmail: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@rshop.com

# ============ APPLICATION ============
APP_URL=http://localhost:5000

# For production:
# APP_URL=https://your-app-name.onrender.com
