# RShop Server Configurations
# Copy this file to ".env" and fill in real values on your machine or CI provider.
PORT=5000

# Security Secrets (Change in production)
JWT_SECRET=YOUR_JWT_SECRET
SESSION_SECRET=YOUR_SESSION_SECRET

# Google OAuth 2.0 Credentials (Get from Google Cloud Console)
# Replace with your actual credentials. Do NOT commit real secrets to Git.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
